    options:
    - text: The iris
      partId: 
      misconception: 
      correct: 1
      feedback: 
    - text: The pupil
      partId: 
      misconception: pupil-controls-itself
      correct: 0
      feedback: The pupil is the opening that shrank; the iris around it changed
