    demo: replayAccommodation
    trialAfterAnswer: 0
    correctFeedback: "Yes \u2014 for a distant object the lens becomes less curved."
    tag: "SupplementalAdaptive \xB7 newly authored practice (not storyboard dialogue)"
  - id: acc_name
    topic: accommodation
    chapter: Scene06
    level: 1
    mode: 0
    prompt: What is the continuous adjustment of the lens to focus objects at different
