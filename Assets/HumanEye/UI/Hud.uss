/* Dark, high-contrast panels; restrained cyan for selection/accent; meaning never by colour alone. */
.root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: rgb(236, 242, 248); font-size: 20px; }
.safe { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 14px; justify-content: space-between; }
.labels-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.spacer { flex-grow: 1; }
.row { flex-direction: row; align-items: center; }
.row-wrap { flex-direction: row; flex-wrap: wrap; align-items: center; }

.panel { background-color: rgba(7, 14, 26, 0.88); border-radius: 12px; border-width: 1px; border-color: rgba(120, 200, 230, 0.28); padding: 10px 14px; }
.panel-title { font-size: 15px; color: rgb(150, 210, 232); -unity-font-style: bold; margin-bottom: 4px; letter-spacing: 1px; }

.btn { min-height: 48px; min-width: 48px; padding: 6px 16px; margin: 4px; border-radius: 10px; font-size: 18px;
       background-color: rgb(24, 40, 60); color: rgb(236, 242, 248); border-width: 1px; border-color: rgba(160, 210, 235, 0.35);
       -unity-font-style: bold; transition-duration: 0.12s; }
.btn:hover { background-color: rgb(32, 56, 82); }
.btn:active { background-color: rgb(18, 90, 115); }
.btn.small { min-height: 44px; font-size: 16px; padding: 4px 12px; }
.btn.square { min-width: 52px; -unity-text-align: middle-center; }
.btn.big { min-height: 58px; font-size: 22px; padding: 8px 26px; }
.btn-accent { background-color: rgb(10, 105, 135); border-color: rgb(110, 225, 250); }
.btn-accent:hover { background-color: rgb(14, 125, 160); }
.btn-danger { background-color: rgb(110, 30, 34); border-color: rgb(230, 120, 120); }
.btn.unavailable { opacity: 0.42; border-color: rgba(160, 160, 160, 0.3); }
.btn.selected { border-color: rgb(110, 225, 250); border-width: 3px; background-color: rgb(10, 80, 105); }
.btn.pulse { border-color: rgb(140, 235, 255); border-width: 3px; background-color: rgb(10, 115, 145); }
.btn.done { border-left-width: 6px; border-left-color: rgb(110, 225, 160); }

.topbar { flex-direction: row; align-items: flex-start; }
.title-block { max-width: 46%; }
.chapter-title { font-size: 22px; -unity-font-style: bold; white-space: normal; }
.progress { flex-direction: row; margin-top: 6px; }
.dot { width: 30px; height: 30px; border-radius: 15px; margin-right: 5px; font-size: 13px; -unity-text-align: middle-center;
       background-color: rgb(28, 42, 60); color: rgb(170, 190, 205); border-width: 1px; border-color: rgba(160, 210, 235, 0.3); }
.dot.current { background-color: rgb(10, 105, 135); color: white; border-color: rgb(110, 225, 250); border-width: 2px; }
.dot.complete { background-color: rgb(28, 80, 60); color: rgb(200, 255, 225); }
.top-buttons { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; max-width: 60%; }

.prompt-banner { display: none; position: absolute; top: 108px; left: 18%; right: 18%; font-size: 22px; -unity-text-align: middle-center; white-space: normal;
                 border-color: rgb(110, 225, 250); border-width: 2px; -unity-font-style: bold; }
.lens-state { display: none; position: absolute; top: 120px; left: 14px; font-size: 18px; white-space: normal; min-width: 300px; max-width: 34%; }

.middle { flex-grow: 1; flex-direction: row; align-items: center; margin-top: 70px; margin-bottom: 8px; }
.part-list { display: none; max-width: 230px; }
.part-list .btn { -unity-text-align: middle-left; }
.view-controls { display: none; width: 140px; }

.bottom { align-items: center; }
.subtitle-panel { display: none; flex-direction: column; align-items: center; max-width: 72%; min-width: 40%; margin-bottom: 6px; }
.speaker { font-size: 15px; color: rgb(150, 210, 232); -unity-font-style: bold; letter-spacing: 1px; }
.subtitle-text { white-space: normal; -unity-text-align: middle-center; font-size: 24px; }
.subs-0 .subtitle-text { font-size: 19px; }
.subs-1 .subtitle-text { font-size: 24px; }
.subs-2 .subtitle-text { font-size: 30px; }
.subs-3 .subtitle-text { font-size: 38px; }
.action-row { flex-direction: row; align-items: center; justify-content: center; flex-wrap: wrap; }
.abilities { flex-direction: row; flex-wrap: wrap; padding: 4px; }
.ability { min-width: 104px; letter-spacing: 1px; }

.sim-panel { display: none; margin-bottom: 6px; max-width: 80%; }
.slider { min-width: 240px; flex-grow: 1; }
.readout { font-size: 18px; margin-left: 10px; white-space: normal; }
.note { font-size: 15px; color: rgb(180, 196, 210); white-space: normal; margin-top: 4px; }
.tag { font-size: 14px; color: rgb(150, 210, 232); white-space: normal; margin-bottom: 6px; -unity-font-style: italic; }

.insets { display: none; position: absolute; right: 16px; top: 120px; flex-direction: row; }
.inset { align-items: center; margin-left: 10px; }
.inset-image { width: 200px; height: 200px; border-radius: 100px; background-color: rgb(10, 10, 14); border-width: 3px; border-color: rgb(110, 225, 250); }
.retina-bg { background-color: rgb(150, 55, 28); }
.inset-caption { font-size: 16px; white-space: normal; max-width: 220px; -unity-text-align: middle-center; margin-top: 6px; }

.journey { display: none; position: absolute; left: 4%; right: 4%; top: 104px; flex-direction: row; flex-wrap: wrap; justify-content: center; }
.stage-chip { padding: 6px 10px; margin: 3px; border-radius: 8px; background-color: rgb(24, 40, 60); font-size: 16px; }
.stage-chip.lit { background-color: rgb(10, 105, 135); border-width: 2px; border-color: rgb(110, 225, 250); }
.stage-chip.past { background-color: rgb(28, 70, 60); }

.modal-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; display: none; }
.modal-layer.dim { background-color: rgba(0, 0, 0, 0.55); }
.modal-layer.black { background-color: rgb(0, 0, 0); }
.modal-layer.start { background-color: rgba(2, 6, 14, 0.82); }
.card { max-width: 760px; min-width: 420px; max-height: 92%; padding: 18px 22px; }
.card-title { font-size: 26px; -unity-font-style: bold; margin-bottom: 6px; white-space: normal; }
.card-text { font-size: 20px; white-space: normal; margin-bottom: 8px; }
.start-title { font-size: 40px; -unity-font-style: bold; color: rgb(170, 235, 255); margin-bottom: 8px; }
.start-card { align-items: stretch; }
.feedback { font-size: 19px; white-space: normal; color: rgb(255, 236, 190); margin-top: 6px; }
.hint { font-size: 18px; white-space: normal; color: rgb(170, 235, 255); margin-top: 4px; }
.setting-label { min-width: 150px; }
.topic-row { flex-direction: row; align-items: center; flex-wrap: wrap; border-bottom-width: 1px; border-color: rgba(160, 210, 235, 0.2); padding: 4px 0; }
.topic-name { min-width: 230px; font-size: 18px; }
.topic-status { min-width: 190px; font-size: 18px; -unity-font-style: bold; }

.side-panel { position: absolute; right: 14px; top: 90px; bottom: 14px; width: 440px; display: none; }
.ask-input { flex-grow: 1; min-height: 48px; font-size: 18px; }

.toast { position: absolute; left: 30%; right: 30%; top: 205px; -unity-text-align: middle-center; white-space: normal; font-size: 19px; opacity: 0; transition-duration: 0.25s; }
.toast.show { opacity: 1; }
.fade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); opacity: 0; }

.world-label { position: absolute; padding: 6px 12px; min-height: 40px; border-radius: 10px; background-color: rgba(7, 14, 26, 0.9);
               border-width: 2px; border-color: rgb(110, 225, 250); color: white; font-size: 18px; -unity-font-style: bold; }
.world-label.passive { border-width: 1px; border-color: rgba(160, 210, 235, 0.5); min-height: 30px; font-size: 16px; }

/* Portrait fallback: stack panels, keep touch targets, hide nothing essential. */
.portrait .top-buttons { max-width: 100%; }
.portrait .topbar { flex-direction: column; }
.portrait .title-block { max-width: 100%; }
.portrait .middle { flex-direction: column; justify-content: flex-end; align-items: stretch; }
.portrait .part-list { max-width: 100%; }
.portrait #part-buttons { flex-direction: row; flex-wrap: wrap; }
.portrait .view-controls { width: auto; flex-direction: row; flex-wrap: wrap; }
.portrait .subtitle-panel { max-width: 100%; }
.portrait .prompt-banner { left: 4%; right: 4%; top: 190px; }
.portrait .toast { left: 6%; right: 6%; top: 300px; }
.portrait .side-panel { left: 8px; right: 8px; width: auto; top: 180px; }
.portrait .insets { top: 200px; flex-direction: column; }
.portrait .card { min-width: 300px; max-width: 96%; }

#btn-read-continue, #btn-free-continue, #act-tap-hint { display: none; }
