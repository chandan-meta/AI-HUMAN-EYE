/* Observatory UI: shared native UI Toolkit styling. Values documented in UI_STYLE_GUIDE.md. */
.root { --surface: rgb(9, 22, 37); --raised: rgb(19, 40, 59); --border: rgb(63, 99, 119); --accent: rgb(105, 224, 240); --text: rgb(238, 246, 250); position: absolute; left: 0; top: 0; right: 0; bottom: 0; color: var(--text); font-size: 20px; }
.safe { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 18px; justify-content: space-between; }
.labels-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.spacer { flex-grow: 1; }
.row { flex-direction: row; align-items: center; }
.row-wrap { flex-direction: row; flex-wrap: wrap; align-items: center; }
.panel { background-color: rgba(9, 22, 37, .96); border-radius: 16px; border-width: 1px; border-color: var(--border); padding: 12px 16px; }
.panel-title { font-size: 16px; color: var(--accent); -unity-font-style: bold; margin-bottom: 6px; }
.btn { min-height: 52px; min-width: 48px; flex-shrink: 0; padding: 8px 16px; margin: 4px; border-radius: 10px; font-size: 18px; white-space: normal; background-color: var(--raised); color: var(--text); border-width: 1px; border-color: var(--border); -unity-font-style: bold; -unity-text-align: middle-center; transition-property: background-color, border-color; transition-duration: .12s; }
.btn:hover { background-color: rgb(30, 60, 78); border-color: rgb(134, 185, 204); }
.btn:active { background-color: rgb(18, 73, 88); }
.btn:focus { border-color: rgb(245, 205, 133); border-width: 3px; }
.btn.small { min-height: 48px; font-size: 16px; padding: 6px 12px; }
.btn.square { min-width: 52px; }
.btn.big { min-height: 64px; font-size: 23px; padding: 12px 24px; }
.btn-accent { background-color: rgb(9, 100, 121); border-color: var(--accent); }
.btn-accent:hover { background-color: rgb(14, 119, 139); }
.btn-danger { background-color: rgb(85, 36, 45); border-color: rgb(207, 125, 130); }
.btn.unavailable, .btn:disabled { color: rgb(149, 164, 177); background-color: rgb(18, 29, 42); border-color: rgb(42, 60, 76); }
.btn.selected { border-color: var(--accent); border-left-width: 5px; background-color: rgb(17, 70, 86); }
.btn.pulse { border-color: var(--accent); border-width: 2px; background-color: rgb(9, 100, 121); }
.btn.done { border-left-width: 5px; border-left-color: rgb(118, 196, 159); }
.topbar { flex-direction: row; align-items: flex-start; }
.title-block { width: 440px; max-width: 40%; padding: 12px 16px; }
.chapter-title { font-size: 23px; -unity-font-style: bold; white-space: normal; }
.progress { flex-direction: row; margin-top: 8px; }
.dot { width: 32px; height: 32px; border-radius: 16px; margin-right: 6px; font-size: 14px; -unity-text-align: middle-center; background-color: rgb(20, 37, 52); color: rgb(177, 199, 211); border-width: 1px; border-color: var(--border); }
.dot.current { background-color: rgb(9, 100, 121); color: white; border-color: var(--accent); border-width: 2px; -unity-font-style: bold; }
.dot.complete { background-color: rgb(29, 71, 61); color: rgb(200, 248, 223); }
.top-buttons { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; max-width: 60%; }
.top-buttons .btn { padding: 8px 14px; font-size: 17px; }
.prompt-banner { display: none; position: absolute; top: 132px; left: 21%; right: 21%; font-size: 21px; -unity-text-align: middle-center; white-space: normal; border-left-width: 4px; border-left-color: var(--accent); }
.lens-state { display: none; position: absolute; top: 142px; left: 14px; font-size: 17px; white-space: normal; max-width: 260px; }
.middle { flex-grow: 1; flex-direction: row; align-items: center; margin-top: 78px; margin-bottom: 8px; }
.part-list { display: none; width: 246px; padding: 12px 10px; }
.part-list .btn { -unity-text-align: middle-left; font-size: 18px; }
.view-controls { display: none; width: 158px; padding: 12px 8px; }
.bottom { align-items: center; }
.subtitle-panel { display: none; flex-direction: column; align-items: center; width: 780px; max-width: 68%; margin-bottom: 10px; border-top-color: var(--accent); padding: 12px 22px; }
.speaker { font-size: 15px; color: var(--accent); -unity-font-style: bold; letter-spacing: 1px; margin-bottom: 4px; }
.subtitle-text { white-space: normal; -unity-text-align: middle-center; font-size: 24px; }
.subs-0 .subtitle-text { font-size: 20px; }
.subs-1 .subtitle-text { font-size: 24px; }
.subs-2 .subtitle-text { font-size: 30px; }
.subs-3 .subtitle-text { font-size: 36px; }
.action-row { flex-direction: row; align-items: center; justify-content: center; flex-wrap: wrap; }
.abilities { flex-direction: row; flex-wrap: wrap; justify-content: center; padding: 4px; }
.ability { min-width: 116px; }
.sim-panel { display: none; margin-bottom: 8px; max-width: 82%; }
.slider { min-width: 180px; flex-grow: 1; min-height: 48px; }
.readout { font-size: 18px; margin-left: 10px; white-space: normal; }
.note { font-size: 16px; color: rgb(181, 203, 216); white-space: normal; margin-top: 6px; }
.tag { font-size: 16px; color: rgb(152, 206, 220); white-space: normal; margin-bottom: 14px; }
.insets { display: none; position: absolute; right: 190px; top: 216px; flex-direction: row; }
.inset { width: 160px; align-items: center; margin-left: 10px; padding: 10px; }
.inset-image { width: 124px; height: 124px; border-radius: 62px; background-color: rgb(7, 15, 25); border-width: 2px; border-color: var(--accent); }
.retina-bg { background-color: rgb(75, 33, 25); }
.inset-caption { font-size: 16px; white-space: normal; -unity-text-align: middle-center; margin-top: 8px; }
.journey { display: none; position: absolute; left: 4%; right: 4%; top: 136px; flex-direction: row; flex-wrap: wrap; justify-content: center; }
.stage-chip { padding: 8px 12px; margin: 4px; border-radius: 8px; background-color: var(--raised); font-size: 16px; white-space: normal; }
.stage-chip.lit { background-color: rgb(9, 100, 121); border-width: 1px; border-color: var(--accent); }
.stage-chip.past { background-color: rgb(29, 71, 61); }
.modal-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; display: none; background-color: rgba(2, 8, 16, .48); }
.modal-layer.dim { background-color: rgba(2, 8, 16, .68); }
.modal-layer.black { background-color: rgb(2, 8, 16); }
.modal-layer.start { background-color: rgba(2, 8, 16, .08); align-items: center; justify-content: flex-end; padding-bottom: 8%; }
.card { width: 740px; max-width: 88%; min-width: 0; max-height: 90%; padding: 24px 28px; border-top-color: var(--accent); }
.card-title { font-size: 30px; -unity-font-style: bold; margin-bottom: 10px; white-space: normal; }
.card-text { font-size: 22px; white-space: normal; margin-bottom: 14px; }
.start-title { font-size: 44px; -unity-font-style: bold; color: var(--text); margin-bottom: 16px; white-space: normal; }
.start-card { width: 780px; max-width: 68%; align-items: stretch; padding: 30px; border-color: var(--accent); border-radius: 24px; }
.start-card .start-title, .start-card .card-text, .start-card .eyebrow { -unity-text-align: middle-center; }
.start-card .card-text { color: rgb(183, 210, 224); font-size: 21px; }
.eyebrow { color: var(--accent); font-size: 15px; letter-spacing: 3px; margin-bottom: 14px; }
#start-continue { font-size: 20px; }
#act-options { flex-direction: column; align-items: stretch; }
#act-options .btn { -unity-text-align: middle-left; min-height: 54px; }
.feedback { font-size: 21px; white-space: normal; color: rgb(182, 237, 207); margin-top: 12px; }
.hint { font-size: 19px; white-space: normal; color: rgb(241, 216, 169); margin-top: 8px; }
.setting-label { min-width: 150px; }
.card Toggle, .card Slider { min-height: 48px; margin-top: 6px; font-size: 18px; }
.topic-row { flex-direction: row; align-items: center; flex-wrap: wrap; border-bottom-width: 1px; border-color: var(--border); padding: 8px 0; }
.topic-name { min-width: 240px; font-size: 18px; }
.topic-status { min-width: 170px; font-size: 18px; -unity-font-style: bold; }
.side-panel { position: absolute; right: 16px; top: 140px; bottom: 110px; width: 460px; display: none; padding: 22px; }
.ask-input { flex-grow: 1; min-width: 0; min-height: 48px; font-size: 19px; }
.toast { position: absolute; left: 32%; right: 32%; top: 220px; -unity-text-align: middle-center; white-space: normal; font-size: 18px; opacity: 0; transition-duration: .2s; }
.toast.show { opacity: 1; }
.fade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(0, 0, 0); opacity: 0; }
.world-label { position: absolute; padding: 8px 12px; min-height: 48px; border-radius: 10px; background-color: rgba(9, 22, 37, .96); border-width: 1px; border-color: var(--accent); color: var(--text); font-size: 18px; -unity-font-style: bold; }
.world-label.passive { border-color: var(--border); min-height: 32px; font-size: 16px; }
.reduced-motion .btn, .reduced-motion .toast { transition-duration: 0s; }
.compact .title-block { width: 350px; max-width: 37%; padding: 8px 10px; }
.compact .chapter-title { font-size: 20px; }
.compact .dot { width: 27px; height: 27px; margin-right: 4px; font-size: 12px; }
.compact .top-buttons { max-width: 63%; }
.compact .top-buttons .btn { min-height: 48px; font-size: 16px; padding: 6px 10px; margin: 3px; }
.compact .prompt-banner { left: 17%; right: 17%; top: 142px; font-size: 18px; }
.compact .part-list { width: 210px; padding: 8px; }
.compact .part-list .btn { font-size: 16px; padding: 6px 10px; min-height: 48px; }
.compact .view-controls { width: 140px; }
.compact .ability { min-width: 92px; font-size: 16px; padding: 6px 10px; min-height: 48px; }
.compact .subtitle-panel { max-width: 76%; padding: 10px 16px; }
.compact .insets { right: 172px; top: 226px; }
.compact .inset { width: 130px; }
.compact .inset-image { width: 92px; height: 92px; }
.compact .inset-caption { font-size: 14px; }
.compact .start-card { width: 600px; padding: 24px; }
.compact .start-title { font-size: 36px; }
.compact .toast { top: 218px; left: 27%; right: 27%; }
.portrait .topbar { flex-direction: column; }
.portrait .top-buttons, .portrait .title-block { max-width: 100%; }
.portrait .middle { flex-direction: column; justify-content: flex-end; align-items: stretch; }
.portrait .part-list { width: auto; }
.portrait #part-buttons { flex-direction: row; flex-wrap: wrap; }
.portrait .view-controls { width: auto; flex-direction: row; flex-wrap: wrap; }
.portrait .subtitle-panel { max-width: 100%; }
.portrait .prompt-banner { left: 4%; right: 4%; top: 230px; }
.portrait .side-panel { left: 12px; right: 12px; width: auto; top: 180px; }
.portrait .insets { top: 260px; right: 14px; flex-direction: column; }
.portrait .modal-layer.start { align-items: center; padding-left: 0; }
#btn-read-continue, #btn-free-continue, #act-tap-hint { display: none; }
